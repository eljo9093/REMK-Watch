<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <UserConfigurations>
        <ColorConfiguration id="theme_color" displayName="theme_color_name" defaultValue="0">
            <!-- 0=Cyan(XP/RadarRim) 1=Emerald(Kcal) 2=Orange(Sätze) -->
            <ColorOption id="0" displayName="theme_sport" colors="#ff00d4ff #ff10b981 #ffff5e00" />
            <ColorOption id="1" displayName="theme_arctic" colors="#ff38bdf8 #fff8fafc #ff7dd3fc" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#ff05070b">
        <!-- 1. BASE TRACK -->
        <PartDraw x="12" y="12" width="426" height="426">
            <Variant mode="AMBIENT" target="alpha" value="35" />
            <Arc centerX="213" centerY="213" width="388" height="388" startAngle="0" endAngle="360">
                <Stroke color="#ff1e293b" thickness="22" cap="BUTT" />
            </Arc>
        </PartDraw>

        <!-- 2. SLOT 1: LEFT XP ARC (210° -> 330°) -->
        <ComplicationSlot x="12" y="12" width="426" height="426" slotId="1"
            name="slot_xp" displayName="slot_xp_name"
            isCustomizable="true" supportedTypes="RANGED_VALUE SHORT_TEXT">
            <BoundingArc centerX="213" centerY="213" width="388" height="388" thickness="28"
                startAngle="210" endAngle="330" isClockwise="true" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkLevelXpComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="STEP_COUNT"
                defaultSystemProviderType="RANGED_VALUE" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Variant mode="AMBIENT" target="alpha" value="95" />
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="210" endAngle="330">
                        <Transform target="endAngle" value="210 + 120 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.16, 1)" />
                        <Stroke color="[CONFIGURATION.theme_color.0]" thickness="22" cap="BUTT" />
                    </Arc>
                </PartDraw>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="210" endAngle="295">
                        <Stroke color="[CONFIGURATION.theme_color.0]" thickness="22" cap="BUTT" />
                    </Arc>
                </PartDraw>
            </Complication>
        </ComplicationSlot>

        <!-- 3. SLOT 2: RIGHT KCAL ARC (30° -> 150°) -->
        <ComplicationSlot x="12" y="12" width="426" height="426" slotId="2"
            name="slot_kcal" displayName="slot_kcal_name"
            isCustomizable="true" supportedTypes="RANGED_VALUE SHORT_TEXT">
            <BoundingArc centerX="213" centerY="213" width="388" height="388" thickness="28"
                startAngle="30" endAngle="150" isClockwise="true" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkKcalComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="RANGED_VALUE" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Variant mode="AMBIENT" target="alpha" value="95" />
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="30" endAngle="150">
                        <Transform target="endAngle" value="30 + 120 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.16, 1)" />
                        <Stroke color="[CONFIGURATION.theme_color.1]" thickness="22" cap="BUTT" />
                    </Arc>
                </PartDraw>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="30" endAngle="120">
                        <Stroke color="[CONFIGURATION.theme_color.1]" thickness="22" cap="BUTT" />
                    </Arc>
                </PartDraw>
            </Complication>
        </ComplicationSlot>

        <!-- 4. SLOT 3: BOTTOM SÄTZE ARC (155° -> 205°) -->
        <ComplicationSlot x="12" y="12" width="426" height="426" slotId="3"
            name="slot_sets" displayName="slot_sets_name"
            isCustomizable="true" supportedTypes="RANGED_VALUE SHORT_TEXT">
            <BoundingArc centerX="213" centerY="213" width="388" height="388" thickness="28"
                startAngle="155" endAngle="205" isClockwise="true" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkSetsComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="STEP_COUNT"
                defaultSystemProviderType="RANGED_VALUE" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Variant mode="AMBIENT" target="alpha" value="90" />
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="155" endAngle="205">
                        <Transform target="endAngle" value="155 + 50 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.18, 1)" />
                        <Stroke color="[CONFIGURATION.theme_color.2]" thickness="20" cap="BUTT" />
                    </Arc>
                </PartDraw>
                <PartText x="133" y="346" width="160" height="24">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="16" weight="BOLD" color="[CONFIGURATION.theme_color.2]">
                            <Template>SÄTZE %s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="155" endAngle="195">
                        <Stroke color="[CONFIGURATION.theme_color.2]" thickness="20" cap="BUTT" />
                    </Arc>
                </PartDraw>
            </Complication>
        </ComplicationSlot>

        <!-- 5. 48-SEGMENT MASK -->
        <PartImage x="0" y="0" width="450" height="450">
            <Image resource="bezel_segment_mask" />
        </PartImage>

        <!-- 6. TOP CURVE INFO -->
        <PartText x="95" y="48" width="260" height="26">
            <Variant mode="AMBIENT" target="alpha" value="130" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="17" weight="BOLD" color="#ff94a3b8">
                    <Template>RE:MK 360° • %s %s.%s • %s%%<Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[DAY_Z]" /><Parameter expression="[MONTH_Z]" /><Parameter expression="[BATTERY_PERCENT]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- 7. UPPER MONUMENTAL CLOCK (17:42 08) -->
        <PartText x="75" y="84" width="268" height="92">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="82" weight="BOLD" color="#ffffffff">
                    <Template>%s:%s<Parameter expression="[HOUR_0_23_Z]" /><Parameter expression="[MINUTE_Z]" /></Template>
                </Font>
            </Text>
        </PartText>
        <PartText x="336" y="132" width="44" height="30">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="START">
                <Font family="SYNC_TO_DEVICE" size="22" weight="BOLD" color="[CONFIGURATION.theme_color.0]">
                    <Template>%s<Parameter expression="[SECOND_Z]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- 8. CENTERPIECE: SAPPHIRE RADAR APERTURE (LIVE 6-AXIS RADAR SMALL_IMAGE!) -->
        <PartDraw x="145" y="182" width="160" height="160">
            <Variant mode="AMBIENT" target="alpha" value="55" />
            <Ellipse x="0" y="0" width="160" height="160">
                <Fill color="#ff111827" />
                <Stroke color="[CONFIGURATION.theme_color.0]" thickness="3" />
            </Ellipse>
        </PartDraw>

        <ComplicationSlot x="149" y="186" width="152" height="152" slotId="4"
            name="slot_radar" displayName="slot_radar_name"
            isCustomizable="true" supportedTypes="SMALL_IMAGE">
            <BoundingRoundBox x="0" y="0" width="152" height="152" cornerRadius="76" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkRadarImageComplicationService"
                primaryProviderType="SMALL_IMAGE"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <Complication type="SMALL_IMAGE">
                <PartImage x="0" y="0" width="152" height="152">
                    <Variant mode="AMBIENT" target="alpha" value="80" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
        </ComplicationSlot>

        <!-- LEFT FLANK PILL: LV. 24 / RANG (SLOT 5) -->
        <PartDraw x="56" y="218" width="84" height="78">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <RoundRectangle x="0" y="0" width="84" height="78" cornerRadiusX="18" cornerRadiusY="18">
                <Fill color="#ff111827" />
                <Stroke color="[CONFIGURATION.theme_color.0]" thickness="2" />
            </RoundRectangle>
        </PartDraw>
        <ComplicationSlot x="56" y="218" width="84" height="78" slotId="5"
            name="slot_rank" displayName="slot_rank_name"
            isCustomizable="true" supportedTypes="SHORT_TEXT">
            <BoundingRoundBox x="0" y="0" width="84" height="78" cornerRadius="18" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkRankBadgeComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="4" y="12" width="76" height="28">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD" color="[CONFIGURATION.theme_color.0]">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="4" y="42" width="76" height="24">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="14" weight="BOLD" color="#ffcbd5e1">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- RIGHT FLANK PILL: LIVE HEART RATE + STEPS -->
        <PartDraw x="310" y="218" width="84" height="78">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <RoundRectangle x="0" y="0" width="84" height="78" cornerRadiusX="18" cornerRadiusY="18">
                <Fill color="#ff111827" />
                <Stroke color="[CONFIGURATION.theme_color.1]" thickness="2" />
            </RoundRectangle>
        </PartDraw>
        <PartText x="312" y="229" width="80" height="28">
            <Variant mode="AMBIENT" target="alpha" value="130" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD" color="#fff8fafc">
                    <Template>❤️%s<Parameter expression="[HEART_RATE]" /></Template>
                </Font>
            </Text>
        </PartText>
        <PartText x="312" y="261" width="80" height="24">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="14" weight="BOLD" color="[CONFIGURATION.theme_color.1]">
                    <Template>👟%s<Parameter expression="[STEP_COUNT]" /></Template>
                </Font>
            </Text>
        </PartText>
    </Scene>
</WatchFace>
