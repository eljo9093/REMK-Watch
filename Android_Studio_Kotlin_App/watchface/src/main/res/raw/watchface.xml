<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <UserConfigurations>
        <ColorConfiguration id="theme_color" displayName="@string/theme_color_name" defaultValue="iron_orange">
            <!-- Index: 0=Primary Accent(Sätze/Min/Bar/Bolt) 1=Secondary(Kcal) 2=Tertiary(Wasser) 3=Heart/PulseBar -->
            <ColorOption id="iron_orange" displayName="@string/theme_iron_orange"
                colors="#ffff5e00 #ff10b981 #ff38bdf8 #ffef4444" />
            <ColorOption id="ice_white" displayName="@string/theme_ice_white"
                colors="#ff38bdf8 #fff8fafc #ff7dd3fc #ff38bdf8" />
            <ColorOption id="pure_white" displayName="@string/theme_pure_white"
                colors="#ffffffff #ff94a3b8 #ff38bdf8 #ffe2e8f0" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#ff05070b">
        <!-- 1. FULL 360° GUNMETAL BASE SEGMENT TRACK (INACTIVE TELEMETRY BLOCKS) -->
        <PartDraw x="12" y="12" width="426" height="426">
            <Variant mode="AMBIENT" target="alpha" value="45" />
            <Arc centerX="213" centerY="213" width="388" height="388" startAngle="0" endAngle="360">
                <Stroke color="#ff2c3545" thickness="24" cap="FLAT" />
            </Arc>
        </PartDraw>

        <!-- 2. COMPLICATION SLOT 1: LEFT SEGMENTED ARC (RE:MK SÄTZE, 210° -> 330°) -->
        <ComplicationSlot x="12" y="12" width="426" height="426" slotId="1"
            name="slot_sets" displayName="@string/slot_sets_name"
            isCustomizable="true" supportedTypes="RANGED_VALUE SHORT_TEXT">
            <BoundingArc centerX="213" centerY="213" width="388" height="388" thickness="30"
                startAngle="210" endAngle="330" isClockwise="true" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkSetsComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="STEP_COUNT"
                defaultSystemProviderType="RANGED_VALUE" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Variant mode="AMBIENT" target="alpha" value="110" />
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="210" endAngle="330">
                        <Transform target="endAngle" value="210 + 120 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.15, 1)" />
                        <Stroke color="[CONFIGURATION.theme_color.0]" thickness="24" cap="FLAT" />
                    </Arc>
                </PartDraw>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="210" endAngle="305">
                        <Stroke color="[CONFIGURATION.theme_color.0]" thickness="24" cap="FLAT" />
                    </Arc>
                </PartDraw>
            </Complication>
        </ComplicationSlot>

        <!-- 3. COMPLICATION SLOT 2: RIGHT SEGMENTED ARC (RE:MK KCAL, 30° -> 150°) -->
        <ComplicationSlot x="12" y="12" width="426" height="426" slotId="2"
            name="slot_kcal" displayName="@string/slot_kcal_name"
            isCustomizable="true" supportedTypes="RANGED_VALUE SHORT_TEXT">
            <BoundingArc centerX="213" centerY="213" width="388" height="388" thickness="30"
                startAngle="30" endAngle="150" isClockwise="true" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkKcalComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="RANGED_VALUE" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Variant mode="AMBIENT" target="alpha" value="110" />
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="30" endAngle="150">
                        <Transform target="endAngle" value="30 + 120 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.15, 1)" />
                        <Stroke color="[CONFIGURATION.theme_color.1]" thickness="24" cap="FLAT" />
                    </Arc>
                </PartDraw>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="30" endAngle="125">
                        <Stroke color="[CONFIGURATION.theme_color.1]" thickness="24" cap="FLAT" />
                    </Arc>
                </PartDraw>
            </Complication>
        </ComplicationSlot>

        <!-- 4. COMPLICATION SLOT 3: BOTTOM SEGMENTED ARC (RE:MK WASSER, 155° -> 205°) + LIVE "1,75 L" LABEL -->
        <ComplicationSlot x="12" y="12" width="426" height="426" slotId="3"
            name="slot_water" displayName="@string/slot_water_name"
            isCustomizable="true" supportedTypes="RANGED_VALUE SHORT_TEXT">
            <BoundingArc centerX="213" centerY="213" width="388" height="388" thickness="30"
                startAngle="155" endAngle="205" isClockwise="true" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkWaterComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="RANGED_VALUE" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Variant mode="AMBIENT" target="alpha" value="100" />
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="155" endAngle="205">
                        <Transform target="endAngle" value="155 + 50 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.18, 1)" />
                        <Stroke color="[CONFIGURATION.theme_color.2]" thickness="22" cap="FLAT" />
                    </Arc>
                </PartDraw>
                <PartText x="133" y="346" width="160" height="26">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD" color="[CONFIGURATION.theme_color.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="155" endAngle="195">
                        <Stroke color="[CONFIGURATION.theme_color.2]" thickness="22" cap="FLAT" />
                    </Arc>
                </PartDraw>
                <PartText x="133" y="346" width="160" height="26">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD" color="[CONFIGURATION.theme_color.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- 5. 48-SEGMENT RADIAL BLACK MASK (TURNS ALL 3 ARCS + TRACK INTO EXACT 24691.jpg BLOCKS!) -->
        <PartImage x="0" y="0" width="450" height="450">
            <Image resource="bezel_segment_mask" />
        </PartImage>

        <!-- 6. INNER RIM LABELS: "SÄTZE" (LEFT) & "KCAL" (RIGHT) -->
        <PartText x="40" y="232" width="64" height="24" angle="72" pivotX="0.5" pivotY="0.5">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="14" weight="BOLD" color="[CONFIGURATION.theme_color.0]">
                    SÄTZE
                </Font>
            </Text>
        </PartText>

        <PartText x="346" y="232" width="64" height="24" angle="-72" pivotX="0.5" pivotY="0.5">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="14" weight="BOLD" color="[CONFIGURATION.theme_color.1]">
                    KCAL
                </Font>
            </Text>
        </PartText>

        <!-- 7. TOP 12 O'CLOCK BATTERY + "RE ⚡ MK" SIGNATURE LOGO -->
        <PartText x="155" y="54" width="140" height="24">
            <Variant mode="AMBIENT" target="alpha" value="140" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD" color="#ff94a3b8">
                    <Template>🔋 %s%%<Parameter expression="[BATTERY_PERCENT]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- "RE" (Left of Bolt) -->
        <PartText x="135" y="80" width="76" height="32">
            <Variant mode="AMBIENT" target="alpha" value="170" />
            <Text align="END">
                <Font family="SYNC_TO_DEVICE" size="25" weight="BOLD" color="#fff8fafc">
                    RE
                </Font>
            </Text>
        </PartText>

        <!-- Dynamic Colored RE:MK Center Lightning Bolt -->
        <PartText x="211" y="77" width="28" height="36">
            <Variant mode="AMBIENT" target="alpha" value="180" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="26" weight="BOLD" color="[CONFIGURATION.theme_color.0]">
                    ⚡
                </Font>
            </Text>
        </PartText>

        <!-- "MK" (Right of Bolt) -->
        <PartText x="239" y="80" width="76" height="32">
            <Variant mode="AMBIENT" target="alpha" value="170" />
            <Text align="START">
                <Font family="SYNC_TO_DEVICE" size="25" weight="BOLD" color="#ffcbd5e1">
                    MK
                </Font>
            </Text>
        </PartText>

        <!-- 8. DATE LINE ABOVE SPLIT CLOCK ("DO • 19. NOV") -->
        <PartText x="95" y="116" width="260" height="28">
            <Variant mode="AMBIENT" target="alpha" value="160" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD" color="#ffcbd5e1">
                    <Template>%s • %s. %s<Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[DAY_Z]" /><Parameter expression="[MONTH_S]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- 9. SIGNATURE TWO-TONE SPLIT ATHLETIC CLOCK: WHITE HOURS | GLOWING BAR | ACCENT MINUTES + SECONDS -->
        <DigitalClock x="42" y="148" width="166" height="106">
            <TimeText x="0" y="0" width="166" height="106" align="END" format="hh" hourFormat="24">
                <Font family="SYNC_TO_DEVICE" size="92" weight="BOLD" color="#ffffffff" />
            </TimeText>
        </DigitalClock>

        <!-- Soft Outer Glow + Crisp Core Vertical Power Divider -->
        <PartDraw x="217" y="160" width="16" height="82" alpha="65">
            <Variant mode="AMBIENT" target="alpha" value="35" />
            <RoundRectangle x="0" y="0" width="16" height="82" cornerRadiusX="8" cornerRadiusY="8">
                <Fill color="[CONFIGURATION.theme_color.0]" />
            </RoundRectangle>
        </PartDraw>
        <PartDraw x="222" y="164" width="6" height="74">
            <Variant mode="AMBIENT" target="alpha" value="160" />
            <RoundRectangle x="0" y="0" width="6" height="74" cornerRadiusX="3" cornerRadiusY="3">
                <Fill color="[CONFIGURATION.theme_color.0]" />
            </RoundRectangle>
        </PartDraw>

        <DigitalClock x="236" y="148" width="132" height="106">
            <TimeText x="0" y="0" width="132" height="106" align="START" format="mm">
                <Font family="SYNC_TO_DEVICE" size="92" weight="BOLD" color="[CONFIGURATION.theme_color.0]" />
            </TimeText>
        </DigitalClock>

        <!-- Tucked Seconds Readout (Hidden in Ambient Mode) -->
        <DigitalClock x="356" y="206" width="44" height="30">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <TimeText x="0" y="0" width="44" height="30" align="START" format="ss">
                <Font family="SYNC_TO_DEVICE" size="23" weight="BOLD" color="#ff94a3b8" />
            </TimeText>
        </DigitalClock>

        <!-- 10. INDUSTRIAL TELEMETRY HUD CAPSULE BELOW CLOCK (#121722) -->
        <PartDraw x="76" y="268" width="298" height="70">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <RoundRectangle x="0" y="0" width="298" height="70" cornerRadiusX="20" cornerRadiusY="20">
                <Fill color="#ff121722" />
                <Stroke color="#ff25324a" thickness="2" />
            </RoundRectangle>
            <!-- Internal Vertical Divider -->
            <Rectangle x="148" y="12" width="2" height="46">
                <Fill color="#ff25324a" />
            </Rectangle>
        </PartDraw>

        <!-- Left HUD Half: Live Heart Rate + 5-Segment Live HR-Zone Micro-Bar (EXACT 24691.jpg LOOK!) -->
        <PartText x="82" y="274" width="138" height="28">
            <Variant mode="AMBIENT" target="alpha" value="130" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD" color="#fff8fafc">
                    <Template>❤️ %s BPM<Parameter expression="[HEART_RATE]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- 5 Mini HR-Zone Blocks inside Left HUD -->
        <PartDraw x="100" y="308" width="16" height="14">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <RoundRectangle x="0" y="0" width="16" height="14" cornerRadiusX="4" cornerRadiusY="4">
                <Fill color="[CONFIGURATION.theme_color.3]" />
            </RoundRectangle>
        </PartDraw>
        <PartDraw x="120" y="308" width="16" height="14">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Transform target="alpha" value="([HEART_RATE] >= 100) ? 255 : 65" />
            <RoundRectangle x="0" y="0" width="16" height="14" cornerRadiusX="4" cornerRadiusY="4">
                <Fill color="[CONFIGURATION.theme_color.0]" />
            </RoundRectangle>
        </PartDraw>
        <PartDraw x="140" y="308" width="16" height="14">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Transform target="alpha" value="([HEART_RATE] >= 125) ? 255 : 65" />
            <RoundRectangle x="0" y="0" width="16" height="14" cornerRadiusX="4" cornerRadiusY="4">
                <Fill color="#ff64748b" />
            </RoundRectangle>
        </PartDraw>
        <PartDraw x="160" y="308" width="16" height="14">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Transform target="alpha" value="([HEART_RATE] >= 145) ? 255 : 65" />
            <RoundRectangle x="0" y="0" width="16" height="14" cornerRadiusX="4" cornerRadiusY="4">
                <Fill color="#ff64748b" />
            </RoundRectangle>
        </PartDraw>
        <PartDraw x="180" y="308" width="16" height="14">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Transform target="alpha" value="([HEART_RATE] >= 165) ? 255 : 65" />
            <RoundRectangle x="0" y="0" width="16" height="14" cornerRadiusX="4" cornerRadiusY="4">
                <Fill color="#ff64748b" />
            </RoundRectangle>
        </PartDraw>

        <!-- Right HUD Half: COMPLICATION SLOT 4 (RE:MK ACTIVE SET: "🏋️ S1/3" + "• 40kg" -> 1-TAP APP LAUNCH!) -->
        <ComplicationSlot x="228" y="272" width="140" height="62" slotId="4"
            name="slot_workout" displayName="@string/slot_workout_name"
            isCustomizable="true" supportedTypes="SHORT_TEXT">
            <BoundingRoundBox x="0" y="0" width="140" height="62" cornerRadius="14" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkActiveSetComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="DATE"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="4" width="140" height="28">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="19" weight="BOLD" color="[CONFIGURATION.theme_color.0]">
                            <Template>🏋️ %s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="32" width="140" height="26">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD" color="#ffcbd5e1">
                            <Template>• %s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
