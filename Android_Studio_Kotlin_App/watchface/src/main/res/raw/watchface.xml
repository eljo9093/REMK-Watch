<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Scene backgroundColor="#ff05070b">
        <!-- INDUSTRIAL TELEMETRY OUTER BEZEL TRACKS (3 SEPARATE ASYMMETRIC ARCS - NO GENERIC CIRCLES) -->
        <PartDraw x="12" y="12" width="426" height="426">
            <Variant mode="AMBIENT" target="alpha" value="65" />
            <!-- Subtle Gunmetal Perimeter Hairline -->
            <Arc centerX="213" centerY="213" width="420" height="420" startAngle="0" endAngle="360">
                <Stroke color="#ff182132" thickness="2" />
            </Arc>
            <!-- Left Arc Track (Sätze / Kraft: 215° to 325°) -->
            <Arc centerX="213" centerY="213" width="398" height="398" startAngle="215" endAngle="325">
                <Stroke color="#ff2a160c" thickness="14" cap="ROUND" />
            </Arc>
            <!-- Right Arc Track (Makros / Kcal: 35° to 145°) -->
            <Arc centerX="213" centerY="213" width="398" height="398" startAngle="35" endAngle="145">
                <Stroke color="#ff0d261c" thickness="14" cap="ROUND" />
            </Arc>
            <!-- Bottom Arc Track (Wasser / Hydration: 160° to 200°) -->
            <Arc centerX="213" centerY="213" width="398" height="398" startAngle="160" endAngle="200">
                <Stroke color="#ff0e2238" thickness="10" cap="ROUND" />
            </Arc>
            <!-- Precision Top Telemetry Markers -->
            <Arc centerX="213" centerY="213" width="398" height="398" startAngle="-14" endAngle="14">
                <Stroke color="#ff334155" thickness="3" cap="ROUND" />
            </Arc>
        </PartDraw>

        <!-- COMPLICATION SLOT 1: LEFT ORANGE ARC (RE:MK SÄTZE) -->
        <ComplicationSlot x="12" y="12" width="426" height="426" slotId="1"
            name="slot_sets" displayName="@string/slot_sets_name"
            isCustomizable="true" supportedTypes="RANGED_VALUE SHORT_TEXT">
            <BoundingArc centerX="213" centerY="213" width="398" height="398" thickness="28"
                startAngle="215" endAngle="325" isClockwise="true" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkSetsComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="STEP_COUNT"
                defaultSystemProviderType="RANGED_VALUE" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Variant mode="AMBIENT" target="alpha" value="120" />
                    <Arc centerX="213" centerY="213" width="398" height="398" startAngle="215" endAngle="325">
                        <Transform target="endAngle" value="215 + 110 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.05, 1)" />
                        <Stroke color="#ffff5e00" thickness="14" cap="ROUND" />
                    </Arc>
                </PartDraw>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Arc centerX="213" centerY="213" width="398" height="398" startAngle="215" endAngle="290">
                        <Stroke color="#ffff5e00" thickness="14" cap="ROUND" />
                    </Arc>
                </PartDraw>
            </Complication>
        </ComplicationSlot>

        <!-- COMPLICATION SLOT 2: RIGHT EMERALD ARC (RE:MK KALORIEN) -->
        <ComplicationSlot x="12" y="12" width="426" height="426" slotId="2"
            name="slot_kcal" displayName="@string/slot_kcal_name"
            isCustomizable="true" supportedTypes="RANGED_VALUE SHORT_TEXT">
            <BoundingArc centerX="213" centerY="213" width="398" height="398" thickness="28"
                startAngle="35" endAngle="145" isClockwise="true" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkKcalComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="RANGED_VALUE" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Variant mode="AMBIENT" target="alpha" value="120" />
                    <Arc centerX="213" centerY="213" width="398" height="398" startAngle="35" endAngle="145">
                        <Transform target="endAngle" value="35 + 110 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.05, 1)" />
                        <Stroke color="#ff10b981" thickness="14" cap="ROUND" />
                    </Arc>
                </PartDraw>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Arc centerX="213" centerY="213" width="398" height="398" startAngle="35" endAngle="115">
                        <Stroke color="#ff10b981" thickness="14" cap="ROUND" />
                    </Arc>
                </PartDraw>
            </Complication>
        </ComplicationSlot>

        <!-- COMPLICATION SLOT 3: BOTTOM CYAN ARC (RE:MK WASSER) -->
        <ComplicationSlot x="12" y="12" width="426" height="426" slotId="3"
            name="slot_water" displayName="@string/slot_water_name"
            isCustomizable="true" supportedTypes="RANGED_VALUE SHORT_TEXT">
            <BoundingArc centerX="213" centerY="213" width="398" height="398" thickness="24"
                startAngle="160" endAngle="200" isClockwise="true" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkWaterComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="RANGED_VALUE" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Variant mode="AMBIENT" target="alpha" value="110" />
                    <Arc centerX="213" centerY="213" width="398" height="398" startAngle="160" endAngle="200">
                        <Transform target="endAngle" value="160 + 40 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.08, 1)" />
                        <Stroke color="#ff38bdf8" thickness="10" cap="ROUND" />
                    </Arc>
                </PartDraw>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Arc centerX="213" centerY="213" width="398" height="398" startAngle="160" endAngle="188">
                        <Stroke color="#ff38bdf8" thickness="10" cap="ROUND" />
                    </Arc>
                </PartDraw>
            </Complication>
        </ComplicationSlot>

        <!-- 12 O'CLOCK RE:MK SIGNATURE BRANDING + BATTERY TELEMETRY -->
        <PartText x="95" y="48" width="260" height="32">
            <Variant mode="AMBIENT" target="alpha" value="140" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="21" weight="BOLD" color="#ffff5e00">
                    <Template>RE:MK ⚡  %s%%</Template>
                    <Parameter expression="[BATTERY_PERCENT]" />
                </Font>
            </Text>
        </PartText>

        <!-- DATE LINE ABOVE SPLIT CLOCK -->
        <PartText x="95" y="88" width="260" height="30">
            <Variant mode="AMBIENT" target="alpha" value="160" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD" color="#ff94a3b8">
                    <Template>%s • %s.%s.</Template>
                    <Parameter expression="[DAY_OF_WEEK_S]" />
                    <Parameter expression="[DAY_Z]" />
                    <Parameter expression="[MONTH_Z]" />
                </Font>
            </Text>
        </PartText>

        <!-- SIGNATURE TWO-TONE SPLIT ATHLETIC CLOCK: WHITE HOURS | ORANGE POWER BAR | ORANGE MINUTES + SECONDS -->
        <DigitalClock x="48" y="136" width="166" height="114">
            <TimeText x="0" y="0" width="166" height="114" align="END" format="HH">
                <Variant mode="AMBIENT" target="color" value="#ffe2e8f0" />
                <Font family="SYNC_TO_DEVICE" size="96" weight="BOLD" color="#fff8fafc" />
            </TimeText>
        </DigitalClock>

        <!-- Glowing Signal-Orange Vertical Power Divider -->
        <PartDraw x="222" y="154" width="6" height="78">
            <Variant mode="AMBIENT" target="alpha" value="150" />
            <RoundRectangle x="0" y="0" width="6" height="78" cornerRadiusX="3" cornerRadiusY="3">
                <Fill color="#ffff5e00" />
            </RoundRectangle>
        </PartDraw>

        <DigitalClock x="236" y="136" width="152" height="114">
            <TimeText x="0" y="0" width="152" height="114" align="START" format="mm">
                <Variant mode="AMBIENT" target="color" value="#ffff8c42" />
                <Font family="SYNC_TO_DEVICE" size="96" weight="BOLD" color="#ffff5e00" />
            </TimeText>
        </DigitalClock>

        <!-- Tucked Seconds Readout (Hidden in Ambient Mode to save OLED battery) -->
        <DigitalClock x="358" y="198" width="48" height="34">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <TimeText x="0" y="0" width="48" height="34" align="START" format="ss">
                <Font family="SYNC_TO_DEVICE" size="24" weight="BOLD" color="#ff94a3b8" />
            </TimeText>
        </DigitalClock>

        <!-- INDUSTRIAL TELEMETRY HUD CAPSULE BELOW CLOCK (#121722) -->
        <PartDraw x="68" y="268" width="314" height="58">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <RoundRectangle x="0" y="0" width="314" height="58" cornerRadiusX="22" cornerRadiusY="22">
                <Fill color="#ff121722" />
                <Stroke color="#ff25324a" thickness="2" />
            </RoundRectangle>
            <!-- Internal Divider -->
            <Rectangle x="156" y="12" width="2" height="34">
                <Fill color="#ff25324a" />
            </Rectangle>
        </PartDraw>

        <!-- Left HUD Module: Live Heart Rate -->
        <PartText x="74" y="280" width="146" height="36">
            <Variant mode="AMBIENT" target="alpha" value="130" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="22" weight="BOLD" color="#fff8fafc">
                    <Template>❤️ %s BPM</Template>
                    <Parameter expression="[HEART_RATE]" />
                </Font>
            </Text>
        </PartText>

        <!-- Right HUD Module: COMPLICATION SLOT 4 (RE:MK ACTIVE SET / REST STATUS - TAP LAUNCHES RE:MK) -->
        <ComplicationSlot x="228" y="274" width="150" height="46" slotId="4"
            name="slot_workout" displayName="@string/slot_workout_name"
            isCustomizable="true" supportedTypes="SHORT_TEXT">
            <BoundingRoundBox x="0" y="0" width="150" height="46" cornerRadius="14" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkActiveSetComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="DATE"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="8" width="150" height="32">
                    <Variant mode="AMBIENT" target="alpha" value="130" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD" color="#ffff5e00">
                            <Template>%s</Template>
                            <Parameter expression="[COMPLICATION.TEXT]" />
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- BOTTOM WATER & STEPS TELEMETRY LABEL -->
        <PartText x="115" y="346" width="220" height="30">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD" color="#ff38bdf8">
                    <Template>👟 %s  •  Brot &amp; Eisen</Template>
                    <Parameter expression="[STEP_COUNT]" />
                </Font>
            </Text>
        </PartText>
    </Scene>
</WatchFace>
