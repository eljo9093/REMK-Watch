<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <UserConfigurations>
        <ColorConfiguration id="theme_color" displayName="theme_color_name" defaultValue="0">
            <!-- 0=Primary(Sätze/Min/Blade) 1=Secondary(Kcal) 2=Cyan(Wasser/Badge) 3=PulseAccent -->
            <ColorOption id="0" displayName="theme_sport" colors="#ffff5e00 #ff10b981 #ff00d4ff #ffef4444" />
            <ColorOption id="1" displayName="theme_arctic" colors="#ff38bdf8 #fff8fafc #ff00d4ff #ff38bdf8" />
            <ColorOption id="2" displayName="theme_minimal" colors="#ffffffff #ff94a3b8 #ff38bdf8 #ffe2e8f0" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#ff05070b">
        <!-- 1. 360° GUNMETAL SEGMENT TRACK -->
        <PartDraw x="12" y="12" width="426" height="426">
            <Variant mode="AMBIENT" target="alpha" value="40" />
            <Arc centerX="213" centerY="213" width="388" height="388" startAngle="0" endAngle="360">
                <Stroke color="#ff202a3b" thickness="24" cap="BUTT" />
            </Arc>
        </PartDraw>

        <!-- 2. SLOT 1: LEFT ARC = SÄTZE (210° -> 330°) -->
        <ComplicationSlot x="12" y="12" width="426" height="426" slotId="1"
            name="slot_sets" displayName="slot_sets_name"
            isCustomizable="true" supportedTypes="RANGED_VALUE SHORT_TEXT">
            <BoundingArc centerX="213" centerY="213" width="388" height="388" thickness="30"
                startAngle="210" endAngle="330" isClockwise="true" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkSetsComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="STEP_COUNT"
                defaultSystemProviderType="RANGED_VALUE" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Variant mode="AMBIENT" target="alpha" value="95" />
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="210" endAngle="330">
                        <Transform target="endAngle" value="210 + 120 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.14, 1)" />
                        <Stroke color="[CONFIGURATION.theme_color.0]" thickness="24" cap="BUTT" />
                    </Arc>
                </PartDraw>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="210" endAngle="295">
                        <Stroke color="[CONFIGURATION.theme_color.0]" thickness="24" cap="BUTT" />
                    </Arc>
                </PartDraw>
            </Complication>
        </ComplicationSlot>

        <!-- 3. SLOT 2: RIGHT ARC = KCAL (30° -> 150°) -->
        <ComplicationSlot x="12" y="12" width="426" height="426" slotId="2"
            name="slot_kcal" displayName="slot_kcal_name"
            isCustomizable="true" supportedTypes="RANGED_VALUE SHORT_TEXT">
            <BoundingArc centerX="213" centerY="213" width="388" height="388" thickness="30"
                startAngle="30" endAngle="150" isClockwise="true" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkKcalComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="RANGED_VALUE" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Variant mode="AMBIENT" target="alpha" value="95" />
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="30" endAngle="150">
                        <Transform target="endAngle" value="30 + 120 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.14, 1)" />
                        <Stroke color="[CONFIGURATION.theme_color.1]" thickness="24" cap="BUTT" />
                    </Arc>
                </PartDraw>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="30" endAngle="120">
                        <Stroke color="[CONFIGURATION.theme_color.1]" thickness="24" cap="BUTT" />
                    </Arc>
                </PartDraw>
            </Complication>
        </ComplicationSlot>

        <!-- 4. SLOT 3: BOTTOM ARC = WASSER (155° -> 205°) + LIVE LITER LABEL -->
        <ComplicationSlot x="12" y="12" width="426" height="426" slotId="3"
            name="slot_water" displayName="slot_water_name"
            isCustomizable="true" supportedTypes="RANGED_VALUE SHORT_TEXT">
            <BoundingArc centerX="213" centerY="213" width="388" height="388" thickness="30"
                startAngle="155" endAngle="205" isClockwise="true" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkWaterComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="RANGED_VALUE" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Variant mode="AMBIENT" target="alpha" value="90" />
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="155" endAngle="205">
                        <Transform target="endAngle" value="155 + 50 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.18, 1)" />
                        <Stroke color="[CONFIGURATION.theme_color.2]" thickness="22" cap="BUTT" />
                    </Arc>
                </PartDraw>
                <PartText x="133" y="344" width="160" height="26">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD" color="[CONFIGURATION.theme_color.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="155" endAngle="195">
                        <Stroke color="[CONFIGURATION.theme_color.2]" thickness="22" cap="BUTT" />
                    </Arc>
                </PartDraw>
                <PartText x="133" y="344" width="160" height="26">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD" color="[CONFIGURATION.theme_color.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- 5. 48-SEGMENT BEZEL MASK -->
        <PartImage x="0" y="0" width="450" height="450">
            <Image resource="bezel_segment_mask" />
        </PartImage>

        <!-- 6. INNER RIM LABELS -->
        <PartText x="38" y="228" width="64" height="24" angle="74" pivotX="0.5" pivotY="0.5">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="13" weight="BOLD" color="[CONFIGURATION.theme_color.0]">SÄTZE</Font>
            </Text>
        </PartText>
        <PartText x="348" y="228" width="64" height="24" angle="-74" pivotX="0.5" pivotY="0.5">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="13" weight="BOLD" color="[CONFIGURATION.theme_color.1]">KCAL</Font>
            </Text>
        </PartText>

        <!-- 7. TOP BRANDING + BATTERY + FLOATING SAPPHIRE LV.-BADGE -->
        <PartText x="105" y="48" width="240" height="24">
            <Variant mode="AMBIENT" target="alpha" value="130" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="16" weight="BOLD" color="#ffcbd5e1">
                    <Template>RE:MK 360° • %s%%<Parameter expression="[BATTERY_PERCENT]" /></Template>
                </Font>
            </Text>
        </PartText>

        <PartDraw x="132" y="76" width="186" height="32">
            <Variant mode="AMBIENT" target="alpha" value="80" />
            <RoundRectangle x="0" y="0" width="186" height="32" cornerRadiusX="16" cornerRadiusY="16">
                <Fill color="#ff111827" />
                <Stroke color="[CONFIGURATION.theme_color.2]" thickness="2" />
            </RoundRectangle>
        </PartDraw>

        <ComplicationSlot x="132" y="76" width="186" height="32" slotId="4"
            name="slot_rank" displayName="slot_rank_name"
            isCustomizable="true" supportedTypes="SHORT_TEXT">
            <BoundingRoundBox x="0" y="0" width="186" height="32" cornerRadius="16" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkRankBadgeComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="4" width="186" height="24">
                    <Variant mode="AMBIENT" target="alpha" value="150" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="16" weight="BOLD" color="[CONFIGURATION.theme_color.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- DATE -->
        <PartText x="105" y="114" width="240" height="26">
            <Variant mode="AMBIENT" target="alpha" value="150" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="19" weight="BOLD" color="#ff94a3b8">
                    <Template>%s • %s. %s<Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[DAY_Z]" /><Parameter expression="[MONTH_S]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- 8. MONUMENTAL TWO-TONE SPLIT CLOCK + VERTICAL LIGHT-BLADE -->
        <PartText x="36" y="144" width="176" height="110">
            <Text align="END">
                <Font family="SYNC_TO_DEVICE" size="94" weight="BOLD" color="#ffffffff">
                    <Template>%s<Parameter expression="[HOUR_0_23_Z]" /></Template>
                </Font>
            </Text>
        </PartText>

        <PartDraw x="217" y="158" width="16" height="84" alpha="65">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <RoundRectangle x="0" y="0" width="16" height="84" cornerRadiusX="8" cornerRadiusY="8">
                <Fill color="[CONFIGURATION.theme_color.0]" />
            </RoundRectangle>
        </PartDraw>
        <PartDraw x="222" y="162" width="6" height="76">
            <Variant mode="AMBIENT" target="alpha" value="150" />
            <RoundRectangle x="0" y="0" width="6" height="76" cornerRadiusX="3" cornerRadiusY="3">
                <Fill color="[CONFIGURATION.theme_color.0]" />
            </RoundRectangle>
        </PartDraw>

        <PartText x="234" y="144" width="136" height="110">
            <Text align="START">
                <Font family="SYNC_TO_DEVICE" size="94" weight="BOLD" color="[CONFIGURATION.theme_color.0]">
                    <Template>%s<Parameter expression="[MINUTE_Z]" /></Template>
                </Font>
            </Text>
        </PartText>

        <PartText x="358" y="204" width="46" height="32">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="START">
                <Font family="SYNC_TO_DEVICE" size="22" weight="BOLD" color="#ff94a3b8">
                    <Template>%s<Parameter expression="[SECOND_Z]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- 9. FROSTED OBSIDIAN-GLASS TELEMETRY CAPSULE (6 O'CLOCK) -->
        <PartDraw x="72" y="268" width="306" height="68">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <RoundRectangle x="0" y="0" width="306" height="68" cornerRadiusX="28" cornerRadiusY="28">
                <Fill color="#ff111827" />
                <Stroke color="#ff334155" thickness="2" />
            </RoundRectangle>
            <Rectangle x="152" y="12" width="2" height="44">
                <Fill color="#ff26344d" />
            </Rectangle>
        </PartDraw>

        <!-- Left Half: Live Heart Rate + 5 Micro Zone Dots -->
        <PartText x="78" y="274" width="144" height="28">
            <Variant mode="AMBIENT" target="alpha" value="120" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="19" weight="BOLD" color="#fff8fafc">
                    <Template>❤️ %s BPM<Parameter expression="[HEART_RATE]" /></Template>
                </Font>
            </Text>
        </PartText>
        <PartDraw x="106" y="309" width="10" height="10">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Ellipse x="0" y="0" width="10" height="10"><Fill color="[CONFIGURATION.theme_color.1]" /></Ellipse>
        </PartDraw>
        <PartDraw x="122" y="309" width="10" height="10">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Transform target="alpha" value="clamp(([HEART_RATE] - 99) * 255, 55, 255)" />
            <Ellipse x="0" y="0" width="10" height="10"><Fill color="[CONFIGURATION.theme_color.2]" /></Ellipse>
        </PartDraw>
        <PartDraw x="138" y="309" width="10" height="10">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Transform target="alpha" value="clamp(([HEART_RATE] - 124) * 255, 55, 255)" />
            <Ellipse x="0" y="0" width="10" height="10"><Fill color="[CONFIGURATION.theme_color.0]" /></Ellipse>
        </PartDraw>
        <PartDraw x="154" y="309" width="10" height="10">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Transform target="alpha" value="clamp(([HEART_RATE] - 144) * 255, 55, 255)" />
            <Ellipse x="0" y="0" width="10" height="10"><Fill color="[CONFIGURATION.theme_color.3]" /></Ellipse>
        </PartDraw>
        <PartDraw x="170" y="309" width="10" height="10">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Transform target="alpha" value="clamp(([HEART_RATE] - 164) * 255, 55, 255)" />
            <Ellipse x="0" y="0" width="10" height="10"><Fill color="#ffa855f7" /></Ellipse>
        </PartDraw>

        <!-- Right Half: SLOT 5 = Active Set / Rest Countdown -> Tap opens Training -->
        <ComplicationSlot x="228" y="272" width="144" height="60" slotId="5"
            name="slot_workout" displayName="slot_workout_name"
            isCustomizable="true" supportedTypes="SHORT_TEXT">
            <BoundingRoundBox x="0" y="0" width="144" height="60" cornerRadius="16" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkActiveSetComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="DATE"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="5" width="144" height="26">
                    <Variant mode="AMBIENT" target="alpha" value="130" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD" color="[CONFIGURATION.theme_color.0]">
                            <Template>🏋️ %s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="31" width="144" height="24">
                    <Variant mode="AMBIENT" target="alpha" value="130" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="16" weight="BOLD" color="#ffcbd5e1">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
