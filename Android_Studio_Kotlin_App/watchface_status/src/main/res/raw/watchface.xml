<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <UserConfigurations>
        <ColorConfiguration id="theme_color" displayName="theme_color_name" defaultValue="0">
            <!-- 0=Cyan(XP/Min/Frame) 1=Emerald(RightArc) 2=Orange(Divider/Accent) -->
            <ColorOption id="0" displayName="theme_sport" colors="#ff00d4ff #ff10b981 #ffff5e00" />
            <ColorOption id="1" displayName="theme_arctic" colors="#ff38bdf8 #fff8fafc #ff7dd3fc" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#ff05070b">
        <!-- 1. BASE TRACK -->
        <PartDraw x="12" y="12" width="426" height="426">
            <Variant mode="AMBIENT" target="alpha" value="35" />
            <Arc centerX="213" centerY="213" width="388" height="388" startAngle="0" endAngle="360">
                <Stroke color="#ff1e293b" thickness="20" cap="BUTT" />
            </Arc>
        </PartDraw>

        <!-- 2. SLOT 1: LEFT XP ARC (210° -> 330°) -->
        <ComplicationSlot x="12" y="12" width="426" height="426" slotId="1"
            name="slot_xp" displayName="slot_xp_name"
            isCustomizable="true" supportedTypes="RANGED_VALUE SHORT_TEXT">
            <BoundingArc centerX="213" centerY="213" width="388" height="388" thickness="26"
                startAngle="210" endAngle="330" isClockwise="true" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkLevelXpComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="STEP_COUNT"
                defaultSystemProviderType="RANGED_VALUE" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Variant mode="AMBIENT" target="alpha" value="95" />
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="210" endAngle="330">
                        <Transform target="endAngle" value="210 + 120 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.16, 1)" />
                        <Stroke color="[CONFIGURATION.theme_color.0]" thickness="20" cap="BUTT" />
                    </Arc>
                </PartDraw>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="210" endAngle="295">
                        <Stroke color="[CONFIGURATION.theme_color.0]" thickness="20" cap="BUTT" />
                    </Arc>
                </PartDraw>
            </Complication>
        </ComplicationSlot>

        <!-- 3. SLOT 2: RIGHT ACTIVITY/KCAL ARC (30° -> 150°) -->
        <ComplicationSlot x="12" y="12" width="426" height="426" slotId="2"
            name="slot_kcal" displayName="slot_kcal_name"
            isCustomizable="true" supportedTypes="RANGED_VALUE SHORT_TEXT">
            <BoundingArc centerX="213" centerY="213" width="388" height="388" thickness="26"
                startAngle="30" endAngle="150" isClockwise="true" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkKcalComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="RANGED_VALUE" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Variant mode="AMBIENT" target="alpha" value="95" />
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="30" endAngle="150">
                        <Transform target="endAngle" value="30 + 120 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.16, 1)" />
                        <Stroke color="[CONFIGURATION.theme_color.1]" thickness="20" cap="BUTT" />
                    </Arc>
                </PartDraw>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="426" height="426">
                    <Arc centerX="213" centerY="213" width="388" height="388" startAngle="30" endAngle="120">
                        <Stroke color="[CONFIGURATION.theme_color.1]" thickness="20" cap="BUTT" />
                    </Arc>
                </PartDraw>
            </Complication>
        </ComplicationSlot>

        <!-- 4. 48-SEGMENT MASK -->
        <PartImage x="0" y="0" width="450" height="450">
            <Image resource="bezel_segment_mask" />
        </PartImage>

        <!-- 5. TOP INFO -->
        <PartText x="95" y="46" width="260" height="24">
            <Variant mode="AMBIENT" target="alpha" value="130" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="16" weight="BOLD" color="#ff94a3b8">
                    <Template>%s %s.%s • RE:MK 360° • %s%%<Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[DAY_Z]" /><Parameter expression="[MONTH_Z]" /><Parameter expression="[BATTERY_PERCENT]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- 6. UPPER TWO-TONE SPLIT CLOCK -->
        <PartText x="52" y="76" width="162" height="92">
            <Text align="END">
                <Font family="SYNC_TO_DEVICE" size="84" weight="BOLD" color="#ffffffff">
                    <Template>%s<Parameter expression="[HOUR_0_23_Z]" /></Template>
                </Font>
            </Text>
        </PartText>
        <PartDraw x="222" y="92" width="6" height="62">
            <Variant mode="AMBIENT" target="alpha" value="150" />
            <RoundRectangle x="0" y="0" width="6" height="62" cornerRadiusX="3" cornerRadiusY="3">
                <Fill color="[CONFIGURATION.theme_color.0]" />
            </RoundRectangle>
        </PartDraw>
        <PartText x="234" y="76" width="128" height="92">
            <Text align="START">
                <Font family="SYNC_TO_DEVICE" size="84" weight="BOLD" color="[CONFIGURATION.theme_color.0]">
                    <Template>%s<Parameter expression="[MINUTE_Z]" /></Template>
                </Font>
            </Text>
        </PartText>
        <PartText x="348" y="128" width="44" height="28">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="START">
                <Font family="SYNC_TO_DEVICE" size="21" weight="BOLD" color="#ff94a3b8">
                    <Template>%s<Parameter expression="[SECOND_Z]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- 7. LEVEL & RANK PILL (SLOT 3) -->
        <PartDraw x="115" y="176" width="220" height="32">
            <Variant mode="AMBIENT" target="alpha" value="85" />
            <RoundRectangle x="0" y="0" width="220" height="32" cornerRadiusX="16" cornerRadiusY="16">
                <Fill color="#ff111827" />
                <Stroke color="[CONFIGURATION.theme_color.0]" thickness="2" />
            </RoundRectangle>
        </PartDraw>
        <ComplicationSlot x="115" y="176" width="220" height="32" slotId="3"
            name="slot_rank" displayName="slot_rank_name"
            isCustomizable="true" supportedTypes="SHORT_TEXT">
            <BoundingRoundBox x="0" y="0" width="220" height="32" cornerRadius="16" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkRankBadgeComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="4" width="220" height="24">
                    <Variant mode="AMBIENT" target="alpha" value="160" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="16" weight="BOLD" color="[CONFIGURATION.theme_color.0]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- 8. LOWER STATUS-WINDOW GLASS PANEL (LIVE 2x3 BARS SMALL_IMAGE!) -->
        <PartDraw x="78" y="218" width="294" height="132">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <RoundRectangle x="0" y="0" width="294" height="132" cornerRadiusX="22" cornerRadiusY="22">
                <Fill color="#ff111827" />
                <Stroke color="[CONFIGURATION.theme_color.0]" thickness="2" />
            </RoundRectangle>
        </PartDraw>

        <ComplicationSlot x="84" y="222" width="282" height="124" slotId="4"
            name="slot_bars" displayName="slot_bars_name"
            isCustomizable="true" supportedTypes="SMALL_IMAGE">
            <BoundingRoundBox x="0" y="0" width="282" height="124" cornerRadius="18" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkStatusBarsImageComplicationService"
                primaryProviderType="SMALL_IMAGE"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <Complication type="SMALL_IMAGE">
                <PartImage x="0" y="0" width="282" height="124">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
        </ComplicationSlot>

        <!-- 9. BOTTOM HEART RATE & WATER STRIP -->
        <PartText x="95" y="362" width="260" height="26">
            <Variant mode="AMBIENT" target="alpha" value="120" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="17" weight="BOLD" color="#ffcbd5e1">
                    <Template>❤️ %s BPM  •  👟 %s<Parameter expression="[HEART_RATE]" /><Parameter expression="[STEP_COUNT]" /></Template>
                </Font>
            </Text>
        </PartText>
    </Scene>
</WatchFace>
