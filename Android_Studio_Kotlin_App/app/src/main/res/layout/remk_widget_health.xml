<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/remk_widget_bg"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="❤️ RE:MK VITAL, SCHRITTE &amp; COACH-CONTROL"
        android:textColor="#F43F5E"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_health_steps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="👟 0 Schritte  •  🔥 0 kcal"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_health_vitals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp"
        android:text="❤️ 62 BPM   |   😴 7,5 Std.   |   ⚡ 92% Fit"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_w_toggle_coach"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.15"
            android:backgroundTint="#FF5E00"
            android:text="🗣️🔥 Coach: AN"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_w_start_timer"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="#10B981"
            android:text="⏱️ 90s Timer"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_w_open_health"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="0.9"
            android:layout_marginStart="6dp"
            android:backgroundTint="#38BDF8"
            android:text="❤️ Vital"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
