<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/remk_widget_bg"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏋️ RE:MK LIVE-WORKOUT &amp; SATZ-LOGGER"
        android:textColor="#FF5E00"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_workout_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="🎯 Bankdrücken • Satz 1"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_workout_next_ex"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp"
        android:text="⚖️ Ziel: 80 kg × 10 Wdh."
        android:textColor="#38BDF8"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_w_minus_weight"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="0.8"
            android:backgroundTint="#1E293B"
            android:text="-2,5 kg"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_w_plus_weight"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="0.8"
            android:layout_marginStart="5dp"
            android:backgroundTint="#1E293B"
            android:text="+2,5 kg"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_w_complete_set_direct"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.35"
            android:layout_marginStart="6dp"
            android:backgroundTint="#10B981"
            android:text="✓ ABHAKEN"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_w_start_workout"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="0.75"
            android:layout_marginStart="6dp"
            android:backgroundTint="#FF5E00"
            android:text="🚀 App"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
