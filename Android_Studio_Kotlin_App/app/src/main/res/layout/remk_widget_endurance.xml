<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/remk_widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/w_endurance_kpi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛒 LIVE-EINKAUFSLISTE (ANTIPPEN = ✓)"
            android:textColor="#10B981"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_w_run"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:backgroundTint="#FF5E00"
            android:text="🛒 Alle öffnen"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_endurance_last"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tippe direkt auf ein Produkt zum Abhaken:"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btn_shop_item_0"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:backgroundTint="#1E293B"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:text="☐ 1,2 kg Geflügelbrustfilet (Hähnchen / Pute)"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_shop_item_1"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#1E293B"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:text="☐ 1,5 kg Magerquark / Skyr Natur"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_shop_item_2"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#1E293B"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:text="☐ 750 g Basmatireis &amp; Haferflocken"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btn_w_walk"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:backgroundTint="#38BDF8"
            android:text="🗺️ GPS-Lauf"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_w_bike"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="#A855F7"
            android:text="🚴 GPS-Rad"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
