<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet, Kamera/Barcode, Vibration, Display-Wachhalter -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- GPS & Maps Outdoor-Tracking (Laufen, Radfahren, Vereins-Runden) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Smartwatch Push-Benachrichtigungen, Herzfrequenz (BLE) & Hardware-Schrittzähler -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="remk" android:host="app" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- WIDGET 1: 🍎 ERNÄHRUNG, YAZIO-SLOTS, REZEPT & WASSER + ZENTRALER ACTION-RECEIVER -->
        <receiver
            android:name=".RemkWidgetProvider"
            android:exported="true"
            android:label="RE:MK 1. Ernährung, Rezept &amp; Yazio-Ringe">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="eu.remk.coaching.ACTION_ADD_WATER_250" />
                <action android:name="eu.remk.coaching.ACTION_TOGGLE_MEAL_SLOT" />
                <action android:name="eu.remk.coaching.ACTION_TOGGLE_SHOP_ITEM" />
                <action android:name="eu.remk.coaching.ACTION_WORKOUT_STEP_WEIGHT" />
                <action android:name="eu.remk.coaching.ACTION_WORKOUT_COMPLETE_SET" />
                <action android:name="eu.remk.coaching.ACTION_TOGGLE_COACH_MUTE" />
                <action android:name="eu.remk.coaching.ACTION_START_TIMER_90" />
                <action android:name="eu.remk.coaching.ACTION_WATCH_COMPLETE_SET" />
                <action android:name="eu.remk.coaching.ACTION_WATCH_LOG_CUSTOM_SET" />
                <action android:name="eu.remk.coaching.ACTION_WATCH_ADD_REST_30" />
                <action android:name="eu.remk.coaching.ACTION_REFRESH_WIDGETS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/remk_widget_info" />
        </receiver>

        <!-- WIDGET 2: 🏋️ LIVE-WORKOUT & DIREKT-SATZ-LOGGER -->
        <receiver
            android:name=".RemkWorkoutWidgetProvider"
            android:exported="true"
            android:label="RE:MK 2. Live-Training &amp; Satz-Logger">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/remk_widget_workout_info" />
        </receiver>

        <!-- WIDGET 3: 🛒 INTERAKTIVE EINKAUFSLISTE & GPS-START -->
        <receiver
            android:name=".RemkEnduranceWidgetProvider"
            android:exported="true"
            android:label="RE:MK 3. Interaktive Einkaufsliste &amp; GPS">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/remk_widget_endurance_info" />
        </receiver>

        <!-- WIDGET 4: ❤️ VITAL, SCHRITTE, COACH AN/AUS & TIMER -->
        <receiver
            android:name=".RemkHealthWidgetProvider"
            android:exported="true"
            android:label="RE:MK 4. Vital, Schritte &amp; Coach-Control">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/remk_widget_health_info" />
        </receiver>
    </application>
</manifest>
